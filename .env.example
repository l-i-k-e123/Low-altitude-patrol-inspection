# ============================================================================
# 低空巡查巡检三维监管平台 — 环境变量示例
# 复制为 .env.development（或 .env.production）后按需修改
# ============================================================================

# ---------------------------------------------------------------------------
# 底图
# ---------------------------------------------------------------------------
# 可选：gaode | tianditu | osm | cesium-ion | natural-earth
#   gaode         高德卫星影像，国内访问稳定，但坐标系为 GCJ-02（与 WGS84 矢量有几十米偏移）
#   tianditu      天地图，WGS84，需要下面的 VITE_TIANDITU_TOKEN
#   osm           OpenStreetMap
#   cesium-ion    Cesium Ion 在线底图，需要 VITE_CESIUM_ION_TOKEN
#   natural-earth 引擎内置离线低清贴图，无网络也能出图
VITE_BASEMAP=gaode

# 天地图 key（https://console.tianditu.gov.cn 申请，仅 tianditu 模式需要）
VITE_TIANDITU_TOKEN=

# Cesium Ion Token（https://ion.cesium.com/tokens 申请，仅 cesium-ion 模式需要）
# 注意：不要把真实 token 提交到仓库
VITE_CESIUM_ION_TOKEN=

# ---------------------------------------------------------------------------
# 三维数据
# ---------------------------------------------------------------------------
# 城市白膜 3D Tiles 入口。仓库不包含该数据集（体积过大），
# 请自行导出倾斜摄影/白膜数据放到 public/ 下并指向此地址；留空则跳过白膜加载
VITE_BUILDING_TILESET=/3dlitest2/tileset.json

# 白膜屏幕空间误差（越小越精细，越吃显存）
VITE_BUILDING_SSE=16

# 白膜显存上限（MB）
VITE_BUILDING_MAX_MB=256

# 底图与地铁就绪后延迟加载白膜的毫秒数
VITE_BUILDING_DEFER_MS=5000

# 地铁线路矢量数据
VITE_SUBWAY_GEOJSON=/geodata/subway.geojson

# 地铁线是否贴地绘制（true 更准但更耗性能）
VITE_SUBWAY_CLAMP_GROUND=false

# 地铁保护区缓冲半径（米）
VITE_PROTECTION_BUFFER_M=30

# ---------------------------------------------------------------------------
# 后端（可选，本仓库不包含 Flask 后端与微信小程序端）
# ---------------------------------------------------------------------------
# 前端请求前缀；生产环境可留空，由 Nginx 同域反代
VITE_API_BASE=

# 可选的远端空间分析服务：不配置则使用前端本地 2.5D 视域估算
VITE_ANALYSIS_BASE=

# ---------------------------------------------------------------------------
# 界面开关
# ---------------------------------------------------------------------------
# 轻量标记模式：关闭脉冲/呼吸动画，低配机器更流畅
VITE_MAP_LITE_MARKERS=false

# 是否用 GLTF 模型表示无人机（false 则用点符号）
VITE_DRONE_USE_GLTF=true

# 无人机模型路径（相对 public）
VITE_DRONE_GLTF_URI=/models/d622d04ee8c44c33a169826bff15db55.gltf

# 地图就绪后延迟加载无人机模型（毫秒）
VITE_DRONE_DEFER_MS=2500

# 启动后是否自动环绕视角
VITE_MAP_AUTO_ORBIT=true
